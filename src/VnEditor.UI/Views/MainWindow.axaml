<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VnEditor.UI.ViewModels"
        xmlns:panels="using:VnEditor.UI.Views.MainWindowPanels"
        xmlns:components="using:VnEditor.UI.Views.MainWindowComponents"
        x:Class="VnEditor.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="640"
        Background="#F4F6FA"
        RequestedThemeVariant="Light"
        Title="{Binding WindowTitle}">

	<Window.KeyBindings>
		<KeyBinding Gesture="Ctrl+N" Command="{Binding FileMenu.NewCommand}" />
		<KeyBinding Gesture="Ctrl+O" Command="{Binding FileMenu.OpenCommand}" />
		<KeyBinding Gesture="Ctrl+S" Command="{Binding FileMenu.SaveCommand}" />
	</Window.KeyBindings>

	<DockPanel LastChildFill="True">
		<components:FileMenuView DockPanel.Dock="Top"
                                 DataContext="{Binding FileMenu}" />

		<Grid Margin="8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="1.1*" MinWidth="190" />
				<ColumnDefinition Width="6" />
				<ColumnDefinition Width="3.8*" MinWidth="360" />
				<ColumnDefinition Width="6" />
				<ColumnDefinition Width="1.3*" MinWidth="220" />
			</Grid.ColumnDefinitions>

			<!-- Navigazione e media condividono il ViewModel del progetto. -->
			<Grid Grid.Column="0" DataContext="{Binding ProjectPanel}">
				<Grid.RowDefinitions>
					<RowDefinition Height="*" MinHeight="200" />
					<RowDefinition Height="6" />
					<RowDefinition Height="1.3*" MinHeight="260" />
				</Grid.RowDefinitions>

				<panels:ScenesPanelView Grid.Row="0" />
				<GridSplitter Grid.Row="1" Background="#E6EAF2"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
				<panels:MediaPanelView Grid.Row="2" />
			</Grid>

			<GridSplitter Grid.Column="1" Background="#E6EAF2"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

			<!-- Anteprima e timeline occupano la colonna centrale. -->
			<Grid Grid.Column="2">
				<Grid.RowDefinitions>
					<RowDefinition Height="3*" MinHeight="280" />
					<RowDefinition Height="6" />
					<RowDefinition Height="1.4*" MinHeight="160" />
				</Grid.RowDefinitions>

				<panels:PreviewPanelView Grid.Row="0" />
				<GridSplitter Grid.Row="1" Background="#E6EAF2"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />
				<panels:TimelinePanelView Grid.Row="2" />
			</Grid>

			<GridSplitter Grid.Column="3" Background="#E6EAF2"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

			<panels:DetailsPanelView Grid.Column="4" />
		</Grid>
	</DockPanel>
</Window>